# Frontend
# Leave empty when the frontend and backend are served from the same origin.
# For a separate deployed backend, set this to the public FastAPI URL.
VITE_API_URL=""
VITE_MAX_FILE_SIZE_MB="25"
VITE_DEV_API_TARGET="http://127.0.0.1:8001"

# Backend
ENVIRONMENT="development"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
FASTAPI_PORT="8001"
API_HOST="0.0.0.0"
API_PORT="8001"

# Local development
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Docker should override these with /app paths.
UPLOAD_DIR="./uploads"
RESULTS_DIR="./results"
SAMPLES_DIR="./backend/samples"

MAX_FILE_SIZE_MB="25"
CONFIDENCE_THRESHOLD="0.70"

# Comma-separated frontend origins when the frontend/backend are on different origins.
# Example:
# CORS_ORIGINS="https://your-frontend.example.com,http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
